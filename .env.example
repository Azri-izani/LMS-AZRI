# Environment Variables
# Salin fail ini kepada .env.local dan isi nilai yang sesuai

# =============================================
# SUPABASE — https://supabase.com
# =============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================
# ADMIN PASSWORD — Password untuk pensyarah
# =============================================
ADMIN_PASSWORD=JKPK12345

# =============================================
# GROQ API — https://console.groq.com/keys
# =============================================
GROQ_API_KEY=your_groq_api_key

# =============================================
# JINA AI (Embedding) — https://jina.ai/api-dashboard
# =============================================
JINA_API_KEY=your_jina_api_key

# =============================================
# NEXTAUTH SECRET — Boleh generate dengan: openssl rand -base64 32
# =============================================
NEXTAUTH_SECRET=your_random_secret_string
NEXTAUTH_URL=http://localhost:3000
